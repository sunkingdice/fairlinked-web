[Unit]
Description=Fairlinked membership application API
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/fairlinked
EnvironmentFile=-/home/deploy/fairlinked/.env
ExecStart=/home/deploy/fairlinked/api/fairlinked-membership-api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
